# Copy to .env.local and fill in from Supabase: Project Settings → API / API Keys.
# Both values are public by design; Tradingo's data is protected by RLS and its tradingo_* functions.
# Never put the database password or a secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
